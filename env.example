# ================================================
# MCP Forge — конфигурация (.env)
# ================================================
# ВАЖНО: не коммитьте .env в git!
# Добавьте .env в .gitignore
# Скопируйте этот файл: cp env.example .env
# ================================================

# ── SMTP (почтовый сервер) ──────────────────────
EMAIL_ADDRESS=your_email@mail.ru
EMAIL_PASSWORD=your_app_password_here
SMTP_SERVER=smtp.mail.ru
SMTP_PORT=465
# Таймаут SMTP-соединения (секунды)
SMTP_TIMEOUT=10

# ── MCP Server ─────────────────────────────────
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
# Таймаут ожидания данных от клиента (секунды).
# Увеличьте при передаче очень больших вложений.
CLIENT_READ_TIMEOUT=120

# ── Режим AI-хоста ─────────────────────────────
# LOCAL  — LM Studio или Ollama (бесплатно, в контуре)
# CLOUD  — внешний API (VseGPT, OpenAI и др.)
AI_MODE=LOCAL

# Используется только при AI_MODE=CLOUD:
# VSEGPT  — api.vsegpt.ru (Claude, GPT-4, Gemini и др.)
# OPENAI  — api.openai.com
CLOUD_PROVIDER=VSEGPT

# ── Локальный режим: LM Studio ─────────────────
#LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_URL=http://192.168.0.103:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.6-35b-a3b

# ── Локальный режим: Ollama (альтернатива) ──────
# LM_STUDIO_URL=http://127.0.0.1:11434/v1
# LM_STUDIO_MODEL=llama3

# ── Облачный режим: VseGPT ─────────────────────
# Документация: https://vsegpt.ru/
# Рекомендуется openai/* для надёжного function calling
# VSEGPT_API_KEY=your_vsegpt_api_key_here
# VSEGPT_BASE_URL=https://api.vsegpt.ru/v1
# VSEGPT_MODEL=openai/gpt-4o-mini
# VSEGPT_TIMEOUT=60

# ── Облачный режим: OpenAI ──────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-nano

# ── DuckDuckGo поиск ────────────────────────────
# Значения по умолчанию для инструмента search_web на стороне СЕРВЕРА.
# Модель может переопределить их в каждом конкретном вызове.
# GUI имеет свои независимые дефолты (раздел GUI_* ниже).

# Количество результатов по умолчанию (1-10)
DDG_MAX_RESULTS=5

# Регион поиска: wt-wt (глобально), ru-ru, us-en, de-de и т.д.
DDG_REGION=wt-wt

# Безопасный поиск: off / moderate / strict
DDG_SAFESEARCH=moderate

# Временной диапазон для ручных вызовов search_web:
# d=день, w=неделя, m=месяц, y=год, пусто=без ограничений.
DDG_TIMELIMIT=

# Временной диапазон для АВТОМАТИЧЕСКИ детектированных поисковых запросов
# (новости, актуальные данные, текущие события).
# Рекомендуется: w (неделя) — свежие результаты без избыточного ограничения.
# d=день, w=неделя, m=месяц, пусто=без ограничений.
DDG_NEWS_TIMELIMIT=w

# Бэкенд DDG: auto / html / lite / api
# auto — автоматически выбирает лучший доступный вариант.
DDG_BACKEND=auto

# Максимальная длина описания результата (символы).
DDG_BODY_MAXLEN=300

# Дополнительные ключевые слова для детектора поисковых запросов.
# Хост форсирует search_web если видит эти слова в запросе пользователя.
# Перечислять через запятую: SEARCH_FORCE_KEYWORDS=биткоин,крипто,курс рубля
SEARCH_FORCE_KEYWORDS=

# ═══════════════════════════════════════════════
# GUI — настройки графического интерфейса
# Файл: gradio_forge_gui.py / mcp_search_gui.py
# ═══════════════════════════════════════════════
#
# GUI_* переменные задают значения полей по умолчанию.
# Пользователь может менять их прямо в интерфейсе —
# при следующем запуске снова применятся значения из .env.
# ═══════════════════════════════════════════════

# ── Порты Gradio ────────────────────────────────
# Основной GUI (gradio_forge_gui.py).
# Адрес в браузере: http://127.0.0.1:7860
GUI_HOST=127.0.0.1
GRADIO_SERVER_PORT=7860

# GUI поиска (mcp_search_gui.py).
# Адрес в браузере: http://127.0.0.1:7861
# Должен отличаться от GRADIO_SERVER_PORT.
GRADIO_SEARCH_PORT=7861

# ── Тема оформления ─────────────────────────────
# Тема по умолчанию при запуске GUI.
# Доступные значения (точное совпадение с именем в списке):
#   ☀️ Светлый   — белый фон, фиолетовые акценты
#   🌙 Ночной    — GitHub Dark, синие акценты
#   🌲 Лесной    — тёмно-зелёный фон
#   🌊 Океан     — синий градиент
#   🔥 Пламя     — оранжево-красные акценты
#   💜 Фиолет    — фиолетовые тона
#   ⬜ Минимал   — минималистичный светлый
# Если значение не распознано — используется первая тема в списке.
GUI_THEME=☀️ Светлый

# ── Вкладка «Поиск» ─────────────────────────────
# Количество результатов по умолчанию в форме поиска (диапазон: 1–10).
GUI_SEARCH_MAX_RESULTS=5

# Регион по умолчанию в форме поиска.
# Допустимые значения: wt-wt, ru-ru, us-en, de-de, fr-fr, uk-ua
GUI_SEARCH_REGION=wt-wt

# Временной диапазон по умолчанию в форме поиска.
# Пусто=без ограничений, d=день, w=неделя, m=месяц, y=год.
GUI_SEARCH_TIMELIMIT=

# ── Вкладка «Новости» ───────────────────────────
# Количество новостей по умолчанию (диапазон: 1–10).
GUI_NEWS_MAX_RESULTS=5

# Регион для новостей по умолчанию.
# ru-ru — русскоязычные источники идут первыми.
# Допустимые значения: wt-wt, ru-ru, us-en, de-de, fr-fr, uk-ua
GUI_NEWS_REGION=ru-ru

# ── Вкладка «Погода» ────────────────────────────
# Единицы температуры: celsius / fahrenheit
GUI_WEATHER_UNITS=celsius

# ── Вкладка «Курсы валют» ───────────────────────
# Базовая валюта (трёхбуквенный код ISO 4217).
GUI_FX_BASE=USD

# Целевые валюты — через запятую, без пробелов.
# Отображаются в форме по умолчанию.
GUI_FX_TARGETS=EUR,RUB,KZT,GBP

# ── Вкладка «Fetch URL» ─────────────────────────
# Максимальное число символов в выводе страницы (диапазон: 500–10000).
# Длинные страницы обрезаются до этого значения.
GUI_FETCH_MAX_CHARS=3000

# ── Вкладка «Пароли» ────────────────────────────
# Длина генерируемого пароля (диапазон: 4–128).
GUI_PW_LENGTH=16

# Количество паролей за один запрос (диапазон: 1–10).
GUI_PW_COUNT=1

# Включать спецсимволы (!@#$%^&* и др.): true / false
GUI_PW_SYMBOLS=true

# ── Вкладка «QR-код» ────────────────────────────
# Размер одной ячейки QR-матрицы в пикселях (диапазон: 5–20).
# Больше = крупнее итоговое изображение.
GUI_QR_BOX_SIZE=10

# Толщина белой рамки вокруг QR-кода в ячейках (диапазон: 1–10).
GUI_QR_BORDER=4

# ── Лимиты и логирование ───────────────────────
# Максимальный размер одного вложения (байты). По умолчанию 10 МБ.
MAX_ATTACHMENT_SIZE=10485760
LOG_LEVEL=INFO

# OUTPUT_MODE — режим вывода в терминале
#
#   PRODUCT  (по умолчанию) — чистый UX для пользователя:
#            • INFO-логи скрыты (root logger → WARNING, httpx/openai заглушены)
#            • перед ответом выводится «⏳ Думаю...»
#            • пользователь видит только: запрос → Думаю... → ответ
#
#   DEBUG    — режим разработчика:
#            • все INFO/WARNING от __main__, httpx, mcp_forge_client видны
#            • удобно при отладке tool_choice и MCP-ответов
#
OUTPUT_MODE=PRODUCT

# ── Режим чата ──────────────────────────────────
#
#   CHAT_MODE — интерфейс взаимодействия с ассистентом:
#
#   TERMINAL  (по умолчанию) — readline REPL в терминале.
#             Запуск: python mcp_forge_host.py
#
#   WEB       — Gradio ChatInterface в браузере.
#             Открывается автоматически на CHAT_PORT.
#             Те же инструменты, та же логика что в терминале —
#             просто другой UI с историей и Markdown-рендерингом.
#
CHAT_MODE=TERMINAL

# Порт веб-чата (CHAT_MODE=WEB).
# Должен отличаться от GRADIO_SERVER_PORT (7860) и GRADIO_SEARCH_PORT (7861).
CHAT_HOST=127.0.0.1
CHAT_PORT=7862

# ═══════════════════════════════════════════════
# СИСТЕМА ПРОМПТОВ — для разработчиков
# Файлы: mcp_forge_host.py, prompt_config.yaml
# ═══════════════════════════════════════════════
#
# Позволяет настраивать поведение языковой модели
# без редактирования исходного кода хоста.
# Удобно при смене модели (Qwen → Llama → Mistral),
# т.к. разные модели требуют разных инструкций.
#
# PROMPT_MODE — режим применения промпта:
#
#   DEFAULT   встроенный SYSTEM_PROMPT, файл игнорируется.
#             Использовать: когда модель работает корректно.
#
#   EXTERNAL  весь промпт берётся из prompt_config.yaml → ключ system_prompt.
#             Встроенный промпт полностью заменяется.
#             Использовать: радикальная смена поведения под конкретную модель.
#
#   APPEND    встроенный промпт + prompt_config.yaml → ключ append.
#             Итог: SYSTEM_PROMPT + "\n\n" + append
#             Использовать: дополнение поведения без переписывания базового.
#
#   REFINE    тонкая настройка: prepend + встроенный + append.
#             Итог: prepend + "\n\n" + SYSTEM_PROMPT + "\n\n" + append
#             Использовать: контекст до промпта + уточнения после него.
#
# Требует: pip install pyyaml
# ═══════════════════════════════════════════════

PROMPT_MODE=DEFAULT

# Путь к файлу конфигурации промптов.
# Относительный путь — от директории mcp_forge_host.py.
# Абсолютный путь тоже поддерживается.
PROMPT_FILE=prompt_config.yaml
EMAIL_EXAMPLE=user@example.com
